# ═══════════════════════════════════════════════════════════════════
# Reference Caddy config for the Skoolcein deployment split.
#
# Not used directly by this repo — copy the relevant blocks into the
# VPS's real Caddyfile. Kept here so the backend/indexer split documented
# in docs/ponder-backend-split-migration.md has a concrete example to
# copy from instead of only prose.
#
# skoolcein.<domain>  → packages/frontend (static SPA)
# api.<domain>        → packages/backend  (REST: /v4, /ipfs, /sse, /webhooks)
# indexer.<domain>    → packages/ponder   (GraphQL/SQL only)
# rpc.<domain>        → the chain node    (JSON-RPC over TLS)
#
# Uses container hostnames (scholarship-frontend, scholarship-backend,
# scholarship-ponder), NOT localhost:<port> — this assumes Caddy itself
# runs as a container attached to the same `nawasena-network` external
# Docker network that docker-compose.yml joins (see its top-level
# `networks:` block). If Caddy instead runs directly on the VPS host
# (not containerized), use `localhost:<host-mapped-port>` for each
# block instead (3102/3103/42069 per docker-compose.yml's `ports:`),
# but don't mix the two styles in the same file — pick one.
# ═══════════════════════════════════════════════════════════════════

skoolcein.nawasena-labs.com {
  reverse_proxy scholarship-frontend:80
}

api.skoolcein.nawasena-labs.com {
  reverse_proxy scholarship-backend:3001
}

indexer.skoolcein.nawasena-labs.com {
  reverse_proxy scholarship-ponder:42069
}

# Chain JSON-RPC, fronted with TLS.
#
# REQUIRED whenever the SPA is served over HTTPS: a page loaded via https://
# cannot call an http:// endpoint — the browser blocks it as "mixed active
# content" and every wagmi/viem request fails silently in the console. Wallet
# extensions are exempt, so the wallet may appear connected while the dApp
# itself reads nothing.
#
# The node here runs on the VPS host (anvil on :8550), not in the Docker
# network, so this block uses a host address rather than a container name.
# Adjust if your node is containerised.
rpc.skoolcein.nawasena-labs.com {
  reverse_proxy 100.73.196.95:8550
}
