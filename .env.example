# ═══════════════════════════════════════════════════════════════════
# SKOOLCEIN — ROOT .env.example
# ═══════════════════════════════════════════════════════════════════
#
# Copy this file:  cp .env.example .env
# NEVER commit .env to version control.
#
# File ini adalah single source of truth untuk docker-compose dan
# local development. Semua service (Ponder, Frontend, Postgres)
# membaca variabel dari sini saat dijalankan lewat Docker Compose.
#
# Untuk local dev per-package (tanpa Docker):
#   - packages/contract/.env      → deploy kontrak
#   - packages/ponder/.env        → indexer only (chain sync, GraphQL/SQL)
#   - packages/backend/.env       → REST API (/v4, /ipfs, /sse, /webhooks)
#   - packages/frontend/.env      → Vite build (hanya VITE_*)
#
# Sejak migrasi backend split: packages/ponder HANYA index blockchain events
# dan serve GraphQL/SQL bawaan Ponder. Semua REST API, upload IPFS, SSE,
# webhook, dan Gemini health-check sekarang ada di packages/backend.
# Lihat docs/ponder-backend-split-migration.md untuk detail.
# ═══════════════════════════════════════════════════════════════════

# ── 1. CHAIN CONFIG ─────────────────────────────────────────────────
# Ponder saat ini hanya index Nawasena fork (chain id: 31338).
CHAIN="nawasena"

# Block pertama setelah semua contract di-deploy.
# Sync script otomatis mengisi dari journal deployment.
START_BLOCK=0

# RPC endpoint untuk Nawasena fork (chain id: 31338)
PONDER_RPC_URL="http://xxx.xxx.xxx.xxx:8550"

# ── 2. CONTRACT ADDRESSES (hasil deployment) ────────────────────────
# Saat pertama kali setup, biarkan default 0x0.
# Setelah deploy, sync script otomatis mengisi file ini.
CONTRACT_CORE="0x0000000000000000000000000000000000000000"
CONTRACT_TREASURY="0x0000000000000000000000000000000000000000"
CONTRACT_BOUNTY="0x0000000000000000000000000000000000000000"
CONTRACT_REPUTATION="0x0000000000000000000000000000000000000000"
CONTRACT_COMMITTEE="0x0000000000000000000000000000000000000000"
CONTRACT_MILESTONE_MANAGER="0x0000000000000000000000000000000000000000"
CONTRACT_ADMIN="0x0000000000000000000000000000000000000000"
CONTRACT_USDC="0x0000000000000000000000000000000000000000"
CONTRACT_FRAUD_NFT="0x0000000000000000000000000000000000000000"

# ScholarshipPriceOracle — token registry + admin-set USD rates.
# Dipakai indexer (index TokenRegistered/PriceUpdated) dan admin UI.
# Rates ini DISPLAY-ONLY: tidak ada kontrak pemindah dana yang membacanya.
CONTRACT_PRICE_ORACLE="0x0000000000000000000000000000000000000000"

# ── 3. DATABASE CONFIG ───────────────────────────────────────────────
# DATABASE_URL = packages/backend's database (REST API, off-chain tables,
# schema `public` — mis. v4_external_learning). Ini yang dipakai backend
# langsung. NOTE: password mengandung karakter "@" harus di-URL-encode
# jadi "%40".
DATABASE_URL="postgresql://xxxxxxx:xxxxxx@postgres:5432/skoolcain_db"

# DATABASE_INDEXER_URL = override untuk packages/ponder (indexer, onchain
# tables, schema `skoolcein`) kalau mau database yang BENAR-BENAR terpisah
# dari backend. Kosongkan → Ponder ikut pakai DATABASE_URL di atas (satu
# Postgres fisik, dua schema terpisah — `public` vs `skoolcein`). Backend
# TIDAK PERNAH baca tabel onchain Ponder langsung dari Postgres — selalu
# lewat PONDER_SQL_URL di atas HTTP (lihat section 10), jadi dua database
# ini 100% independen di level kode.
#
# Buat database-nya dulu di server Postgres sebelum deploy pertama kali:
#   CREATE DATABASE skoolcain_db;
#   CREATE DATABASE skoolcain_indexer_db;   -- kalau mau pakai override ini
DATABASE_INDEXER_URL="postgresql://xxxxxxx:xxxxxx@postgres:5432/skoolcain_indexer_db"

# Wajib diisi karena Postgres ini shared dengan project lain di VPS. Ponder
# mengelola SEMUA tabel onchain-nya sendiri (v4_programs, v4_applicants, dst
# — lihat packages/ponder/ponder.schema.ts) di schema ini, termasuk
# migration/crash-recovery internalnya — tidak ada drizzle-kit yang menyentuh
# schema ini sama sekali. Tanpa DATABASE_SCHEMA ini akan error:
# "BuildError: Database schema required."
DATABASE_SCHEMA="skoolcein"

# SSL: set "true" untuk production (Supabase, Railway, Neon, dll). Berlaku
# untuk kedua koneksi (DATABASE_URL dan DATABASE_INDEXER_URL).
DB_SSL="false"

# Untuk local dev tanpa Docker (postgres di host):
# DATABASE_URL="postgresql://nawasena:nawasena%402026@localhost:5432/skoolcain_db"
# DATABASE_INDEXER_URL="postgresql://nawasena:nawasena%402026@localhost:5432/skoolcain_indexer_db"

# ── 4. FRONTEND SPECIFIC (Vite) ─────────────────────────────────────
# PENTING: VITE_* di-bake ke static JS bundle saat build
# (docker build --build-arg), lalu dijalankan di BROWSER user, bukan
# di dalam docker network. Karena itu HARUS berupa URL publik yang bisa
# diakses dari luar (mis. domain di belakang Caddy reverse proxy),
# BUKAN hostname internal docker seperti "scholarship-backend"/"scholarship-ponder".
#
# VITE_BACKEND_HOST → packages/backend: /v4/*, /ipfs/*, /sse, /webhooks/*
# VITE_INDEXER_HOST → packages/ponder (indexer): /graphql, /sql — Ponder
#   is still the sole owner of these, they did NOT move to backend.
#
# Production (lewat Caddy, lihat Caddyfile api./indexer.<domain> blocks):
VITE_BACKEND_HOST="https://api.skoolcein.nawasena-labs.com"
VITE_INDEXER_HOST="https://indexer.skoolcein.nawasena-labs.com"

# Untuk local dev tanpa Docker:
# VITE_BACKEND_HOST="http://localhost:3001"
# VITE_INDEXER_HOST="http://localhost:42069"

VITE_IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs"

# FRONTEND_PORT = HOST port binding untuk nginx container (default 3102,
# hindari bentrok dengan project lain yang pakai 3100 di VPS yang sama).
# Caddy reverse_proxy tetap pakai container_name:80 internal, jadi
# variabel ini hanya relevan untuk akses langsung ke VPS host.
FRONTEND_PORT=3102

# RPC URL yang dipakai browser untuk koneksi ke chain Nawasena (chain id 31338).
# Fallback di wagmi.config.ts
VITE_RPC_URL="http://xxx.xxx.xxx.xx:8550"

# ── 5. IPFS (packages/backend) ───────────────────────────────────────
# Untuk upload dokumen dan fetch metadata dari IPFS.
# Gunakan Pinata (disarankan) atau IPFS node lokal.
IPFS_HOST="localhost"
IPFS_HOST_REQUEST="http://localhost:8080"
PINATA_JWT=""
PINATA_GATEWAY=""

# ── 6. GEMINI AI (opsional — packages/backend health monitoring) ────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ── 7. WEBHOOK SECRET (opsional — external learning callback, packages/backend) ─
WEBHOOK_SECRET="skoolchein_dev_secret_123"

# ── 8. CONTRACT DEPLOYMENT (hanya untuk local deploy) ─────────────────
# Private key deployer. Hati-hati, jangan commit!
# Untuk nawasena/localhost bisa kosong karena pakai default mnemonic.
DEPLOYER_PRIVATE_KEY=""

# Address USDC existing. Kosongkan agar deploy MockUSDC (local/testnet only).
USDC_ADDRESS=""

# Wallet penerima protocol fee. Kosongkan agar pakai deployer.
PROTOCOL_FEE_RECIPIENT=""

# Default Hardhat/Ganache mnemonic (aman untuk local saja)
MNEMONIC="test test test test test test test test test test test junk"

# ── 9. INDEXER PARAMETERS (packages/ponder) ─────────────────────────
PORT="42069"

# ── 10. BACKEND API PARAMETERS (packages/backend) ───────────────────
# REST API port inside the container (docker-compose maps host 3103 → 3001).
# NOTE: 3100/3101 are already claimed by other projects on shared VPS hosts —
# pick a free port here (see `sudo ss -tulnp` output) if 3103 collides too.
# @ponder/client reads Ponder's onchain tables over SQL-over-HTTP.
# Docker: internal network hostname, not localhost.
# Local dev without Docker: http://localhost:42069/sql
PONDER_SQL_URL="http://scholarship-ponder:42069/sql"
