# ═══════════════════════════════════════════════════════════════════
# SKOOLCEIN — ROOT .env.example
# ═══════════════════════════════════════════════════════════════════
#
# Copy this file:  cp .env.example .env
# NEVER commit .env to version control.
#
# This .env drives docker-compose and local development.
# For production CI/CD, the runner injects the real .env from the host.
# ═══════════════════════════════════════════════════════════════════

# ── CHAIN CONFIG ────────────────────────────────────────────────────
# "lisk" untuk production/testnet, "nawasena" untuk fork lokal, "localhost" untuk hardhat node lokal
CHAIN="nawasena"

# RPC endpoint untuk Lisk Sepolia (chain id: 4202)
PONDER_RPC_URL_LISK="https://rpc.sepolia-api.lisk.com"

# RPC endpoint untuk Nawasena fork (chain id: 31338)
PONDER_RPC_URL_NAWASENA="http://100.73.196.95:8550"

# Block pertama setelah semua contract di-deploy.
# Dapatkan dari tx receipt deployment di blockscout.
START_BLOCK=0

# ── CONTRACT ADDRESSES (hasil deployment) ───────────────────────────
CONTRACT_CORE="0x0000000000000000000000000000000000000000"
CONTRACT_TREASURY="0x0000000000000000000000000000000000000000"
CONTRACT_BOUNTY="0x0000000000000000000000000000000000000000"
CONTRACT_REPUTATION="0x0000000000000000000000000000000000000000"
CONTRACT_COMMITTEE="0x0000000000000000000000000000000000000000"
CONTRACT_MILESTONE_MANAGER="0x0000000000000000000000000000000000000000"
CONTRACT_ADMIN="0x0000000000000000000000000000000000000000"
CONTRACT_USDC="0x0000000000000000000000000000000000000000"
CONTRACT_FRAUD_NFT="0x0000000000000000000000000000000000000000"

# ── DATABASE CONFIG (PostgreSQL) ────────────────────────────────────
# Untuk docker-compose, hostname = service name "scholarship-postgres"
DB_USER="postgres"
DB_PASSWORD="password"
DB_NAME="scholarship_v4"
DB_PORT=5432
DATABASE_URL="postgresql://postgres:password@scholarship-postgres:5432/scholarship_v4"

# Untuk local dev tanpa Docker (postgres di host):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/scholarship_v4"

# ── FRONTEND SPECIFIC (Vite) ────────────────────────────────────────
# Base URL ke Ponder indexer API (GraphQL + REST + SSE)
# Untuk docker-compose, hostname = service name "scholarship-ponder"
VITE_BACKEND_HOST="http://scholarship-ponder:42069"

# Untuk local dev tanpa Docker:
# VITE_BACKEND_HOST="http://localhost:42069"

VITE_IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs"

# ── INDEXER PARAMETERS ──────────────────────────────────────────────
PORT="42069"
