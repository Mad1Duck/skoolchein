# ═══════════════════════════════════════════════════════════════════
# SKOOLCEIN — ROOT .env.example
# ═══════════════════════════════════════════════════════════════════
#
# Copy this file:  cp .env.example .env
# NEVER commit .env to version control.
#
# File ini adalah single source of truth untuk docker-compose dan
# local development. Semua service (Ponder, Frontend, Postgres)
# membaca variabel dari sini saat dijalankan lewat Docker Compose.
#
# Untuk local dev per-package (tanpa Docker):
#   - packages/contract/.env      → deploy kontrak
#   - packages/ponder/.env          → indexer & API
#   - packages/frontend/.env      → Vite build (hanya VITE_*)
# ═══════════════════════════════════════════════════════════════════

# ── 1. CHAIN CONFIG ─────────────────────────────────────────────────
# Pilihan: "lisk" (production/testnet), "nawasena" (fork lokal), "localhost"
CHAIN="nawasena"

# Block pertama setelah semua contract di-deploy.
# Sync script otomatis mengisi dari journal deployment.
START_BLOCK=0

# RPC endpoint untuk Lisk Sepolia (chain id: 4202)
PONDER_RPC_URL_LISK="https://rpc.sepolia-api.lisk.com"

# RPC endpoint untuk Nawasena fork (chain id: 31338)
PONDER_RPC_URL_NAWASENA="http://100.73.196.95:8550"

# ── 2. CONTRACT ADDRESSES (hasil deployment) ────────────────────────
# Saat pertama kali setup, biarkan default 0x0.
# Setelah deploy, sync script otomatis mengisi file ini.
CONTRACT_CORE="0x0000000000000000000000000000000000000000"
CONTRACT_TREASURY="0x0000000000000000000000000000000000000000"
CONTRACT_BOUNTY="0x0000000000000000000000000000000000000000"
CONTRACT_REPUTATION="0x0000000000000000000000000000000000000000"
CONTRACT_COMMITTEE="0x0000000000000000000000000000000000000000"
CONTRACT_MILESTONE_MANAGER="0x0000000000000000000000000000000000000000"
CONTRACT_ADMIN="0x0000000000000000000000000000000000000000"
CONTRACT_USDC="0x0000000000000000000000000000000000000000"
CONTRACT_FRAUD_NFT="0x0000000000000000000000000000000000000000"

# ── 3. DATABASE CONFIG (PostgreSQL) ─────────────────────────────────
# Untuk docker-compose, hostname = service name "scholarship-postgres"
DB_HOST="scholarship-postgres"
DB_USER="postgres"
DB_PASSWORD="password"
DB_NAME="scholarship_v4"
DB_PORT=5432
DB_SSL="false"
DATABASE_URL="postgresql://postgres:password@scholarship-postgres:5432/scholarship_v4"

# Untuk local dev tanpa Docker (postgres di host):
# DB_HOST="localhost"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/scholarship_v4"

# ── 4. FRONTEND SPECIFIC (Vite) ─────────────────────────────────────
# Base URL ke Ponder indexer API (GraphQL + REST + SSE)
# Untuk docker-compose, hostname = service name "scholarship-ponder"
VITE_BACKEND_HOST="http://scholarship-ponder:42069"

# Untuk local dev tanpa Docker:
# VITE_BACKEND_HOST="http://localhost:42069"

VITE_IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs"

# ── 5. IPFS (Ponder) ────────────────────────────────────────────────
# Untuk upload dokumen dan fetch metadata dari IPFS.
# Gunakan Pinata (disarankan) atau IPFS node lokal.
IPFS_HOST="localhost"
IPFS_HOST_REQUEST="http://localhost:8080"
PINATA_JWT=""
PINATA_GATEWAY=""

# ── 6. GEMINI AI (opsional — Ponder health monitoring) ──────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# ── 7. WEBHOOK SECRET (opsional — external learning callback) ─────────
WEBHOOK_SECRET="skoolchein_dev_secret_123"

# ── 8. CONTRACT DEPLOYMENT (hanya untuk local deploy) ─────────────────
# Private key deployer. Hati-hati, jangan commit!
# Untuk nawasena/localhost bisa kosong karena pakai default mnemonic.
DEPLOYER_PRIVATE_KEY=""

# Address USDC existing. Kosongkan agar deploy MockUSDC (local/testnet only).
USDC_ADDRESS=""

# Wallet penerima protocol fee. Kosongkan agar pakai deployer.
PROTOCOL_FEE_RECIPIENT=""

# Default Hardhat/Ganache mnemonic (aman untuk local saja)
MNEMONIC="test test test test test test test test test test test junk"

# ── 9. INDEXER PARAMETERS ───────────────────────────────────────────
PORT="42069"
