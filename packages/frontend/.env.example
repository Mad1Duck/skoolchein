# ═══════════════════════════════════════════════════════════════════
# packages/frontend/.env
# Scholarship Protocol v4 — Frontend (Vite + React) Environment
# ═══════════════════════════════════════════════════════════════════
#
# Copy this file:  cp .env.example .env
# NEVER commit .env to version control.
#
# Semua variabel HARUS diawali VITE_ agar Vite expose ke browser.
# Akses di code: import.meta.env.VITE_NAMA_VARIABLE
#
# Run:
#   Development → bun dev
#   Build       → bun build
# ═══════════════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════════════════
# 1. BACKEND API (packages/backend) — REST, SSE, IPFS upload, webhooks
# ════════════════════════════════════════════════════════════════════
# Dipakai untuk REST API (/v4/...), SSE (/sse), IPFS upload (/ipfs), webhooks.
#
# Local development (packages/backend berjalan di port default 3001):
VITE_BACKEND_HOST="http://localhost:3001"

# Staging / Production (lewat Caddy):
# VITE_BACKEND_HOST="https://api.yourdomain.com"

# ════════════════════════════════════════════════════════════════════
# 1b. INDEXER (packages/ponder) — GraphQL / SQL-over-HTTP
# ════════════════════════════════════════════════════════════════════
# Ponder masih melayani /graphql dan /sql langsung — bukan lewat backend.
#
# Local development (Ponder berjalan di port default 42069):
VITE_INDEXER_HOST="http://localhost:42069"

# Staging / Production (lewat Caddy):
# VITE_INDEXER_HOST="https://indexer.yourdomain.com"

# ════════════════════════════════════════════════════════════════════
# 2. IPFS GATEWAY
# ════════════════════════════════════════════════════════════════════
# URL gateway untuk membaca file dari IPFS (foto, dokumen, essay, dll).
# Dipakai di src/lib/ipfs/index.ts untuk resolve CID ke URL yang bisa dibuka browser.
#
# Kalau KOSONG → fallback ke "https://gateway.pinata.cloud/ipfs"
#
# Opsi publik:
#   https://ipfs.io/ipfs
#   https://cloudflare-ipfs.com/ipfs
#   https://gateway.pinata.cloud/ipfs
# Opsi self-hosted (cloudflare tunnel ke IPFS node lokal):
#   https://your-tunnel.trycloudflare.com/ipfs
VITE_IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs"

# ════════════════════════════════════════════════════════════════════
# 3. RPC ENDPOINT
# ════════════════════════════════════════════════════════════════════
# RPC URL yang dipakai browser untuk koneksi ke chain Nawasena (chain id 31338).
# Fallback: http://100.73.196.95:8550
VITE_RPC_URL="http://100.73.196.95:8550"

# ════════════════════════════════════════════════════════════════════
# 4. WALLET CONNECT & XELLAR (sudah di-hardcode di wagmi.config.ts)
# ════════════════════════════════════════════════════════════════════
# WalletConnect Project ID dan Xellar App ID sudah ada di:
#   src/constants/wagmi.config.ts
#
# Kalau mau override pakai env (opsional — perlu update wagmi.config.ts):
# VITE_WALLETCONNECT_PROJECT_ID="383bde0d30cde408c7f223876495f1b1"
# VITE_XELLAR_APP_ID="cc1ec5df-f51b-4b65-adef-6ce93a1430dc"
# VITE_XELLAR_ENV="sandbox"    # "sandbox" untuk testnet, "production" untuk mainnet
# mock = dev (mint MockUSDC) | guide = panduan beli USDC di exchange (default) | transak = belum tersedia
VITE_RAMP_PROVIDER=mock

# Chain default (sebelum wallet terhubung / saat wallet di chain yang tidak didukung)
VITE_DEFAULT_CHAIN_ID=31338
