# ═══════════════════════════════════════════════════════════════════
# packages/backend/.env
# Scholarship Protocol v4 — Backend (Hono / hono-forge REST API)
# ═══════════════════════════════════════════════════════════════════
#
# Copy this file:  cp .env.example .env
# NEVER commit .env to version control.
#
# Run:
#   Development → bun dev
#   Production  → bun start
#
# NOTE: File ini HANYA dipakai untuk local dev tanpa Docker (bun dev
# langsung di packages/backend). Untuk docker-compose / production di VPS,
# semua variabel dibaca dari ROOT .env (lihat env_file di docker-compose.yml)
# dan sebagian di-override langsung lewat `environment:` block per service.
# Edit root .env.example, bukan file ini, untuk deployment production.
# ═══════════════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════════════════
# 1. SERVER
# ════════════════════════════════════════════════════════════════════
PORT="3001"
NODE_ENV="development"

# ════════════════════════════════════════════════════════════════════
# 2. DATABASE — backend's OWN off-chain tables only (schema `public`)
# ════════════════════════════════════════════════════════════════════
# Genuinely off-chain data backend owns directly (e.g. v4_external_learning).
# This is a DIFFERENT concern from Ponder's onchain tables (skoolcein schema)
# in packages/ponder/.env — backend never touches those directly, only via
# PONDER_SQL_URL below.
#
# This DATABASE_URL is fully independent from Ponder's — it's fine to point
# both at the same local Postgres (like the example below, just a different
# database name) or at two completely separate Postgres instances. Nothing
# in the code assumes they're the same.
DATABASE_URL="postgresql://postgres:password@localhost:5432/skoolcain_db"
DB_SSL="false"

# ════════════════════════════════════════════════════════════════════
# 3. PONDER SQL-OVER-HTTP — reads Ponder's indexed onchain data
# ════════════════════════════════════════════════════════════════════
# Ponder is the sole owner/migrator of onchain tables (v4_programs,
# v4_applicants, etc.) — backend reads them over HTTP, never direct Postgres.
#
# Local dev (Ponder running via `bun dev` in packages/ponder):
PONDER_SQL_URL="http://localhost:42069/sql"

# Docker: internal network hostname, not localhost.
# PONDER_SQL_URL="http://scholarship-ponder:42069/sql"

# ════════════════════════════════════════════════════════════════════
# 4. IPFS
# ════════════════════════════════════════════════════════════════════
# Host IPFS node untuk upload dokumen (write operations).
IPFS_HOST="localhost"

# Gateway URL untuk fetch/read CID dari IPFS.
# Contoh publik: https://ipfs.io, https://cloudflare-ipfs.com
# Contoh Pinata: https://gateway.pinata.cloud
IPFS_HOST_REQUEST="http://localhost:8080"
PINATA_JWT=""
PINATA_GATEWAY=""

# ════════════════════════════════════════════════════════════════════
# 5. WEBHOOK SECRET (opsional — external learning callback)
# ════════════════════════════════════════════════════════════════════
# Dipakai di features/webhooks/webhooks.controller.ts untuk verifikasi
# webhook signature dari HackQuest/Udemy.
WEBHOOK_SECRET="skoolchein_dev_secret_123"

# ════════════════════════════════════════════════════════════════════
# 6. GEMINI AI (opsional — untuk server health monitoring)
# ════════════════════════════════════════════════════════════════════
# Dipakai di features/gemini/gemini.service.ts untuk analisis health check.
# Kalau tidak dipakai, bisa dikosongkan.
# Dapatkan API key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
